# ============================================================================
# wall —— 基于双安路 FPGA 的双屏无缝拼接多媒体播放墙
# 原则：只提交源码、文档、脚本、成品图；构建产物 / 仿真库 / 日志 / 二进制一律不进
# 注意：本文件不支持行尾注释，注释必须单独占一行
# ============================================================================

# ---------------- 构建产物 ----------------
/build/*
!/build/build.ps1

# ---------------- ModelSim 仿真库与工作目录 ----------------
/sim/
/sim_c3/
/sim_elab/
/sim_s1/
/simlib/
/simlib2/
/simlib3/
/work/
/work_tf/
worklib/
modelsim.ini

# ---------------- TD / ModelSim 日志 ----------------
*.log
*.logw
td_*.log
td_*.logw
transcript

# ---------------- 波形与仿真数据 ----------------
*.wlf
*.wstf
*.vcd
*.hex
*.ppm

# ---------------- 交付件与中间报告 ----------------
*.qpf
*_db/
*.qor
*.rpt
*.svf
*.bid
*.bit

# ---------------- 媒体素材（可再生） ----------------
media/*.BMP
media/*.WAV

# ---------------- 历史备份与临时目录 ----------------
/rtl_base_ok/
/tb_base_ok/
/tmp_media/
/rtl/wip/

# ---------------- 工具链二进制 ----------------
/tools/ffmpeg/
__pycache__/
*.pyc
*.exe

# ---------------- 文档中间产物 ----------------
/docs/contest/_src/
/docs/contest/_*.py
/docs/contest/*.log
/docs/contest/*.docx
/docs/contest/*.pdf
/docs/contest/poster_A3_draft.png

# ---------------- 厂商加密 IP（兜底） ----------------
*.enc.v
fpga_hdmi/
vendor/

# ---------------- 操作系统垃圾 ----------------
